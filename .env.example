# Copy to .env for local development. Use your host's secret settings in production.
# Server-only: never prefix these with NEXT_PUBLIC_.

# Required. Supabase > Connect > Transaction pooler URI, with the URL-encoded database password.
DATABASE_URL=

# true when served over HTTPS (production); false for local http://127.0.0.1:3000.
COOKIE_SECURE=false
# Required before first owner sign-up on an HTTPS host. Generate with: openssl rand -hex 32
SETUP_KEY=

# TMDB API Read Access Token (the long bearer token, not the short API key):
# upcoming movies and TV, search, posters and release dates.
TMDB_TOKEN=

# Optional: email reminders via Resend. EMAIL_FROM is the sender, e.g.
# "Lineup <reminders@your-domain.com>" on a domain verified in Resend. Until a domain is
# verified, "Lineup <onboarding@resend.dev>" works but only delivers to your Resend
# account's own address. Reminders go to the email you sign in to Lineup with.
RESEND_API_KEY=
EMAIL_FROM=
# Optional: the app's public URL, for the "Open Lineup" button in emails.
APP_URL=
# Bearer secret for /api/cron/reminders; store the same value as lineup_cron_secret in Supabase Vault.
CRON_SECRET=

# Optional server-to-server API token. Grants full access to the library; leave unset unless needed.
APP_TOKEN=
