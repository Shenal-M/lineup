# Copy to .env.local for local Next.js settings, or use your hosting secrets.
# HOST and PORT for npm start should be set in the shell/hosting environment.
HOST=127.0.0.1
PORT=3000
DB_PATH=data/reel.sqlite
# Use true when the hosted origin uses HTTPS; false for local HTTP development.
COOKIE_SECURE=false
# Optional: TMDB API Read Access Token (bearer token), kept only on the server.
TMDB_TOKEN=
# Optional server-to-server API token. This grants access to the personal library.
APP_TOKEN=

# Required before first account creation on an HTTPS hosted instance.
SETUP_KEY=

# Vercel + Supabase: Connect > Transaction pooler URI, with URL-encoded password.
# Server-only; do not prefix secrets with NEXT_PUBLIC_. Leave unset for local SQLite.
DATABASE_URL=
# Resend API key and a sender from a verified domain.
RESEND_API_KEY=
EMAIL_FROM=
# Generate randomly; also store this exact value as lineup_cron_secret in Supabase Vault.
CRON_SECRET=
